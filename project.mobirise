                "flex-direction": "row-reverse"
              }
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".my": {
              "margin-bottom": "0",
              "margin-top": "auto"
            },
            "h5, h6": {
              "background": "@primaryColor",
              "display": "inline"
            },
            "h5": {
              "position": "relative",
              "z-index": "5",
              "padding": "0 0.5rem"
            },
            "h6": {
              "line-height": "1.3 !important",
              "span": {
                "padding-right": "2rem"
              }
            },
            ".mbr-section-title, .align": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle, .align": {
              "color": "#000000",
              "text-align": "left"
            }
          },
