        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "padding": "80px 60px",
              "display": "flex",
              "justify-content": "center",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "32px 16px"
              },
              "& when (@showImage)": {
                "border": "2px solid @borderImage"
              },
              ".image-wrapper": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "opacity": ".5"
                }
              },
              ".card-wrapper": {
                "position": "relative",
                "z-index": "1",
                "width": "75%",
                "padding": "48px",
                "background-color": "@container",
                "border": "3px solid @border",
                "box-shadow": "4px 4px 0 0 @border",
                "-webkit-flex": "inherit",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "padding": "32px 16px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "32px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff9063",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_name": "article04",
          "_sourceTheme": "servicem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 servicem5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\" selected>\n        <input type=\"color\" title=\"Container Border\" value=\"#ffffff\" name=\"border\" selected>\n        <input type=\"checkbox\" title=\"Image BG\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Image Border Color\" value=\"#000000\" name=\"borderImage\" condition=\"showImage\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">Simplifying Patents with Project Patent by Kaufhold and Dix Patent Law</h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">When considering international patent applications, the first challenge is the diversity of patent laws and procedures across countries. Each jurisdiction has its own requirements, deadlines, and examination standards. A mistake in one country can jeopardize your entire international filing strategy. Patent attorneys are trained to navigate these nuances, ensuring that your intellectual property rights are secured and maintained consistently across borders.<br>\n<br>Moreover, language barriers, differing legal terminology, and varying enforcement practices can create additional layers of complexity. Attempting to manage this on your own can lead to miscommunications or incomplete filings, potentially costing you both time and money. By leveraging the expertise of a patent attorney, inventors can confidently pursue protection in multiple markets while minimizing risks.&nbsp;<br><br></p>\n                    </div>\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"@PROJECT_PATH@/assets/images/patent-attorneys-1280x720.jpg\" alt>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4wmgPw8dg",
          "_anchor": "article04-0",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article1",
          "_sourceTheme": "tutorm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#f3f6f9"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tutorm5 article1\" group=\"Article\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<header>Background</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n\t</mbr-parameters>\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row justify-content-end\">\n\t\t\t<div class=\"col-md-12 col-lg-12\">\n\t\t\t\t<h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">FEATURES</h4>\n\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style mb-4 mt-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">Strategic Guidance Beyond Filing</h3>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-12 col-lg-10\">\n\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Hiring a patent lawyer isn’t just about paperwork—it’s about strategy. A good <a href=\"https://projectpatent.com/\" class=\"text-success\"><b><u>Patent attorney</u></b></a> will assess the commercial potential of your invention, identify markets where protection is most valuable, and advise on how to maximize the reach of your intellectual property. This strategic approach is particularly critical when filing internationally, where the cost and effort of applications can escalate quickly.<br>\n<br>Project Patent by Kaufhold and Dix Patent Law excels in providing this kind of strategic counsel. Their attorneys guide clients through the decision-making process, helping them determine the most effective combination of patents, trademarks, and copyrights to protect their innovations globally. This approach ensures that every intellectual property investment yields maximum value.&nbsp;<br></p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
