          "_name": "list01",
          "_sourceTheme": "workflowm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list1\" group=\"List\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Stylized\" name=\"stylizedCounters\" checked>\n        <input type=\"checkbox\" title=\"Mark\" name=\"mark\" checked condition=\"stylizedCounters\">\n        <select title=\"Type\" name=\"countersType\" condition=\"stylizedCounters\">\n            <option value=\"default\">Сircle Fill</option>\n            <option value=\"circle\">Circle</option>\n            <option value=\"square\" selected>Square</option>\n        </select>\n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#ffffc0\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><b>Project Patent by Kaufhold and Dix Patent Law</b></h4>\n            </div>\n            <div class=\"counter-container col-md-12 col-lg-5\">\n\n                <div class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                    <ul>\n                        <li><a href=\"patent-service.html#article04-2t\" class=\"text-black\">Project Patent by Kaufhold and Dix Patent Law: Your IP Concierge</a></li><a href=\"patent-service.html#article04-2t\" class=\"text-primary\">\n                        </a><li><a href=\"patent-service.html#article1-2u\" class=\"text-black\">Driving Innovation and R&amp;D Investment</a></li><a href=\"patent-service.html#article1-2u\" class=\"text-primary\">\n                        </a><li><a href=\"patent-service.html#article01-2v\" class=\"text-black\">Enhancing Brand Credibility and Trust</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"counter-container col-md-12 col-lg-5\">\n\n                <div class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                    <ul>\n                        <li><a href=\"patent-service.html#aarticle1-2w\" class=\"text-black\">Financial Strategy and Competitive Advantage</a></li><a href=\"patent-service.html#aarticle1-2w\" class=\"text-primary\">\n                        </a><li><a href=\"patent-service.html#article04-2x\" class=\"text-black\">Legal Safeguards and Risk Management</a></li><a href=\"patent-service.html#article04-2x\" class=\"text-primary\">\n                        </a><li><a href=\"patent-service.html#article1-2y\" class=\"text-black\">Fostering Collaborative and Strategic Growth</a></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
