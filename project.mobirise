                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                }
              },
              ".mbr-text": {
                "position": "relative",
                "z-index": "1",
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                }
              },
              ".mbr-section-btn": {
                "position": "relative",
                "z-index": "1"
              },
              ".container-wrapper": {
                "position": "absolute",
                "top": "-2.6rem",
                "left": "-1rem",
                "height": "100%",
                "width": "50%",
                "border": "2px dashed @border",
                "border-top": "none",
                "border-right": "0",
                "border-bottom-left-radius": "16px",
                "@media (max-width: 992px)": {
                  "display": "none"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#08323C"
