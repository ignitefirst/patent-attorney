                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "opacity": ".5"
                }
              },
              ".card-wrapper": {
                "position": "relative",
                "z-index": "1",
                "width": "75%",
                "padding": "48px",
                "background-color": "@container",
                "border": "3px solid @border",
                "box-shadow": "4px 4px 0 0 @border",
                "-webkit-flex": "inherit",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "padding": "32px 16px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "32px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff9063",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_name": "article04",
          "_sourceTheme": "servicem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 servicem5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\" selected>\n        <input type=\"color\" title=\"Container Border\" value=\"#ffffff\" name=\"border\" selected>\n        <input type=\"checkbox\" title=\"Image BG\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Image Border Color\" value=\"#000000\" name=\"borderImage\" condition=\"showImage\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">Safeguard Your Innovations with Project Patent by Kaufhold and Dix Patent Law</h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">Intellectual property is the backbone of protecting your creative and technical innovations. It includes patents, trademark law, and copyright law, each serving a unique purpose. Patents prevent others from making, using, or selling your invention without permission, while trademarks protect brand identity, and copyrights safeguard original works of authorship. Understanding these distinctions is critical for inventors who want to maximize the value of their creations.<br>\n<br>At Project Patent, the team takes time to educate clients about the intricacies of intellectual property. They make it clear how different forms of protection complement each other, providing a holistic strategy rather than a piecemeal approach. For instance, combining patent protection with a trademark can secure not just the invention itself but also its brand presence in the marketplace.<br>\n<br><br></p>\n                    </div>\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"@PROJECT_PATH@/assets/images/1707230089932-1036x720.png\" alt>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4x38wmyXC",
          "_anchor": "article04-2h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article1",
          "_sourceTheme": "tutorm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-text": {
