        {
          "_name": "content5",
          "_sourceTheme": "elevatem5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 40px",
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".title-wrapper": {
              "position": "relative",
              ".mbr-section-title": {
                "position": "relative",
                "z-index": "1",
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                }
              },
              ".mbr-text": {
                "position": "relative",
                "z-index": "1",
                "margin-bottom": "70px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                }
              },
              ".mbr-section-btn": {
                "position": "relative",
                "z-index": "1"
              },
              ".container-wrapper": {
                "position": "absolute",
                "top": "-2.6rem",
                "left": "-1rem",
                "height": "100%",
                "width": "50%",
                "border": "2px dashed @border",
                "border-top": "none",
                "border-right": "0",
                "border-bottom-left-radius": "16px",
                "@media (max-width: 992px)": {
                  "display": "none"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#08323C"
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "justify"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5 elevatem5\" group=\"Content\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Container\" name=\"showContainer\" checked>\n        <input type=\"color\" title=\"Container Color\" value=\"#ffffff\" name=\"border\" condition=\"showContainer\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                        <b>Reprehenderit sequi sint totam. Aperiam delectus <br> dolores eius eveniet.</b>\n                    </h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">In the fast-paced world of innovation, safeguarding your intellectual property is not just a precaution — it’s a necessity. Inventors, creators, and businesses pour years of effort into developing unique products and ideas, and yet, the threat of patent infringement constantly looms. Without proper protection, your hard work could be exploited, replicated, or outright stolen.<br>\n<br>This is where the guidance of an experienced patent attorney becomes indispensable. A skilled patent lawyer not only helps you secure your inventions but also provides proactive strategies to detect and prevent infringement. With the right approach, your intellectual property becomes more than a legal asset; it becomes a powerful tool for market credibility, financial security, and business growth.<br>\n<br>At Project Patent by Kaufhold and Dix Patent Law, we understand the stakes. Our team has helped thousands of inventors and businesses navigate the complex landscape of patents, trademarks, and copyright protection. From understanding the nuances of how to patent an idea to implementing strategies to prevent unauthorized use, our comprehensive patent service ensures your creations remain yours.<br>\n<br><br><br>\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            View Now\n                        </a>\n                    </div>\n                    <div class=\"container-wrapper\" mbr-if=\"showContainer\"></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "v4wX6guU29",
          "_anchor": "content5-1s",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "padding": "80px 60px",
              "display": "flex",
              "justify-content": "center",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "32px 16px"
              },
              "& when (@showImage)": {
                "border": "2px solid @borderImage"
              },
              ".image-wrapper": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "opacity": ".5"
                }
              },
              ".card-wrapper": {
                "position": "relative",
                "z-index": "1",
                "width": "75%",
                "padding": "48px",
                "background-color": "@container",
                "border": "3px solid @border",
                "box-shadow": "4px 4px 0 0 @border",
                "-webkit-flex": "inherit",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "padding": "32px 16px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "32px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff9063",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_name": "article04",
          "_sourceTheme": "servicem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 servicem5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\" selected>\n        <input type=\"color\" title=\"Container Border\" value=\"#ffffff\" name=\"border\" selected>\n        <input type=\"checkbox\" title=\"Image BG\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Image Border Color\" value=\"#000000\" name=\"borderImage\" condition=\"showImage\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/servicem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">Clear Patent Strategies from Project Patent by Kaufhold and Dix Patent Law</h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">Patent infringement occurs when an unauthorized party makes, uses, sells, or imports a patented invention without permission. Often, businesses may unknowingly infringe on existing patents, while in other cases, competitors may deliberately attempt to replicate a product or technology. A thorough understanding of patent rights is essential.<br>\n<br>A seasoned patent attorney assesses potential threats by analyzing existing patents and monitoring market activity. This includes researching competitors’ products, identifying overlaps, and evaluating the scope of your patent claims. Intellectual property protection is not static; it requires ongoing vigilance. The goal is not just to secure a patent but to ensure it actively shields your invention from exploitation.<br>\n<br>At Project Patent, we emphasize clarity and education. Inventors often ask, “how to patent an idea” in a way that maximizes enforceability. Our experts guide clients from the initial ideation stage through filing, ensuring the patent is robust, defensible, and aligned with current trademark law and copyright law considerations.\n<br><br></p>\n                    </div>\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"@PROJECT_PATH@/assets/images/exploring-alternative-solutions-to-the-three-year-law-practice-1600x900201-1600x900.jpg\" alt>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4wX6hQk6j",
          "_anchor": "article04-1t",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
