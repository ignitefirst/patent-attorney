              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "justify-content": "center",
              ".card-wrapper": {
                "background-color": "@cardBg",
                "border": "2px solid @border",
                "width": "58%",
                "padding": "82px",
                "-webkit-flex": "inherit",
                "@media (max-width: 1440px)": {
                  "width": "68%",
                  "padding": "25px"
                },
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "padding": "22px"
                },
                "& when not (@fullWidth)": {
                  "width": "80%",
                  "@media (max-width: 1440px)": {
                    "width": "80%"
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                },
                ".logo-wrapper": {
                  "margin-bottom": "32px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "22px"
                  },
                  "img": {
                    "width": "72px",
                    "height": "72px",
                    "object-fit": "cover",
                    "display": "inline-block"
                  }
                },
                ".title-wrapper": {
                  ".mbr-section-title": {
                    "display": "inline-block",
                    "width": "80%",
                    "margin-bottom": "32px",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "22px"
                    }
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "90%",
                    "margin-bottom": "12px",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#3a001d"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn, .title-wrapper, .logo-wrapper": {
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn, .logo-wrapper, .title-wrapper": {
              "color": "#000000"
            }
          },
          "_name": "article04",
          "_sourceTheme": "patientm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 patientm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffc0\" name=\"cardBg\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#3A001D\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/patientm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/patientm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                            <img class=\"little-radius\" src=\"@ADDONS_PATH@/patientm5/components/_images/logo.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"title-wrapper\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .logo-wrapper, .title-wrapper\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Reducing Legal Risks and Avoiding Pitfalls</h2>\n                        </div>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">Filing an international patent without professional support is risky. Errors in application documents, misinterpretation of local laws, or missed deadlines can result in rejected applications or weakened patent rights. A patent attorney acts as a safeguard, identifying potential issues before they become costly problems.<br>\n<br>Project Patent’s team has a proven track record of guiding inventors through complex IP processes, helping them avoid pitfalls while maximizing the enforceability of their patents. This risk management is crucial for businesses seeking long-term global protection and is one of the most compelling reasons to work with a patent lawyer.&nbsp;<br></p>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Read More\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4wRDvpsAF",
          "_anchor": "article04-1k",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "article1",
          "_sourceTheme": "talkm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"talkm5 article1\" group=\"Article\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"9\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<header>Background</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n\t</mbr-parameters>\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-12 col-md align\">\n\t\t\t\t<h5 class=\"mbr-section-title mbr-fonts-style mt-0 mb-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .align\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t<b>ABOUT US</b>\n\t\t\t\t</h5><br>\n\t\t\t\t<h6 class=\"mbr-section-subtitle mbr-fonts-style mt-0\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle, .align\" mbr-theme-style=\"display-2\">Building Confidence with Expert Support</h6>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-12 my col-lg-6\">\n\t\t\t\t<p class=\"mbr-text mbr-fonts-style mt-0 mb-0 pt-3\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Finally, working with a patent attorney provides peace of mind. The process of filing international patents can be overwhelming, but knowing you have expert guidance allows inventors and companies to focus on what matters most—innovation and growth. With Project Patent, clients are not just filing applications; they are building a long-term IP strategy that supports their business objectives and market ambitions.<br>\n<br>Their attorneys remain available throughout the lifecycle of the patent, providing updates, responding to office actions, and advising on enforcement strategies. This ongoing support ensures that your intellectual property portfolio remains strong and relevant in a constantly evolving global market.&nbsp;<br></p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "& when (@reverseContent)": {
